<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #10251f;
  color: #e7f5ed;
  font-family: Arial, sans-serif;
  text-align: center;
  padding: 20px;
}

.container {
  padding: 30px;
  max-width: 400px;
  width: 100%;
  background: #17362d;
  border: 1px solid #235244;
  border-radius: 16px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}

h2 {
  margin-top: 0;
  font-size: 22px;
  color: #fff;
}

p {
  color: #c1d8cc;
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 24px;
}

.btn {
  display: inline-block;
  background: #167a5a;
  color: #ffffff;
  padding: 14px 24px;
  border-radius: 12px;
  text-decoration: none;
  font-weight: bold;
  font-size: 16px;
  transition: background 0.2s, transform 0.1s;
  width: 100%;
  box-shadow: 0 4px 12px rgba(22, 122, 90, 0.4);
}

.btn:hover {
  background: #1b966f;
  transform: translateY(-2px);
}

.btn:active {
  transform: translateY(0);
}
</style>
</head>

